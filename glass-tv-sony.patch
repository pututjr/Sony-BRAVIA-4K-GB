+package com.gathin.tvhome;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Log;
+
+/**
+ * Kejadian sistem yang membuat jadwal adzan perlu dihitung ulang (TV menyala, jam/zona waktu
+ * diubah, aplikasi diperbarui). Juga {@code com.gathin.tvhome.ADZAN_PREVIEW} dari adb untuk
+ * menggambar peringatan ke PNG tanpa menampilkannya di TV.
+ */
+public class AdzanSystemReceiver extends BroadcastReceiver {
+
+    static final String ACTION_PREVIEW = "com.gathin.tvhome.ADZAN_PREVIEW";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (ACTION_PREVIEW.equals(intent.getAction())) {
+            try {
+                Config cfg = Config.load(context);
+                java.util.Calendar now = java.util.Calendar.getInstance();
+                int[] t = PrayerTimes.forDay(now, cfg.prayerLat, cfg.prayerLng, cfg.prayerIhtiyat);
+                // Waktu sholat berikutnya (Dzuhur-Isya), agar pratinjau cocok dengan layar saat itu.
+                int cur = now.get(java.util.Calendar.HOUR_OF_DAY) * 60 + now.get(java.util.Calendar.MINUTE);
+                int p = 1;
+                for (int i = 1; i <= 4; i++) if (t[i] > cur) { p = i; break; }
+                Log.i(AdzanScheduler.TAG, "preview " + AdzanService.renderWarningPng(context,
+                        PrayerTimes.NAMES[p], PrayerTimes.hhmm(t[p])));
+            } catch (Exception e) {
+                Log.e(AdzanScheduler.TAG, "preview gagal", e);
+            }
+            return;
+        }
+        AdzanScheduler.scheduleNext(context);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/AdzanViews.java b/launcher/app/src/main/java/com/gathin/tvhome/AdzanViews.java
