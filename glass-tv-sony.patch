@@ -0,0 +1,21 @@
+package com.gathin.tvhome;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/**
+ * Menerima alarm adzan (lalu menyalakan {@link AdzanService}) dan kejadian sistem yang membuat
+ * jadwal perlu dihitung ulang: TV baru menyala, jam/zona waktu diubah, atau aplikasi diperbarui.
+ */
+public class AdzanReceiver extends BroadcastReceiver {
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (AdzanScheduler.ACTION_FIRE.equals(intent.getAction())) {
+            Intent s = new Intent(context, AdzanService.class).putExtras(intent);
+            context.startForegroundService(s);
+        }
+        AdzanScheduler.scheduleNext(context);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/AdzanScheduler.java b/launcher/app/src/main/java/com/gathin/tvhome/AdzanScheduler.java
new file mode 100644
index 0000000..8e7e2ee
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/AdzanScheduler.java
@@ -0,0 +1,76 @@
+package com.gathin.tvhome;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Log;
+
+import java.util.Calendar;
+
+/**
+ * Menjadwalkan peringatan 5 menit sebelum adzan dan suara adzan, untuk Dzuhur, Ashar, Maghrib dan
+ * Isya (Subuh dilewati). Hanya satu alarm yang aktif: kejadian berikutnya. Setiap kali alarm
+ * berbunyi, {@link AdzanReceiver} menjadwalkan kejadian sesudahnya.
+ */
+final class AdzanScheduler {
+
+    static final String TAG = "Adzan";
+    static final String ACTION_FIRE = "com.gathin.tvhome.ADZAN_FIRE";
+    static final String EXTRA_KIND = "kind";       // "warn" atau "adzan"
+    static final String EXTRA_PRAYER = "prayer";   // indeks PrayerTimes.NAMES
+    static final String EXTRA_MINUTE = "minute";   // menit sejak 00:00 waktu sholatnya
+    static final int WARN_BEFORE_MIN = 5;
+    /** Indeks waktu sholat yang diberi peringatan dan adzan: Dzuhur, Ashar, Maghrib, Isya. */
+    private static final int[] PRAYERS = {1, 2, 3, 4};
+
+    private AdzanScheduler() {}
+
+    static void scheduleNext(Context context) {
+        Config cfg = Config.load(context);
+        if (!cfg.prayerTimes) return;
+        long now = System.currentTimeMillis();
+        long bestAt = Long.MAX_VALUE;
+        String bestKind = null;
+        int bestPrayer = -1, bestMinute = 0;
+        for (int dayOffset = 0; dayOffset <= 1; dayOffset++) {
+            Calendar day = Calendar.getInstance();
+            day.add(Calendar.DAY_OF_YEAR, dayOffset);
+            int[] t = PrayerTimes.forDay(day, cfg.prayerLat, cfg.prayerLng, cfg.prayerIhtiyat);
+            for (int p : PRAYERS) {
+                for (int k = 0; k < 2; k++) {
+                    int minute = t[p] - (k == 0 ? WARN_BEFORE_MIN : 0);
+                    Calendar at = (Calendar) day.clone();
+                    at.set(Calendar.HOUR_OF_DAY, 0);
+                    at.set(Calendar.MINUTE, 0);
+                    at.set(Calendar.SECOND, 0);
+                    at.set(Calendar.MILLISECOND, 0);
+                    at.add(Calendar.MINUTE, minute);
+                    long ms = at.getTimeInMillis();
+                    if (ms > now + 1000 && ms < bestAt) {
+                        bestAt = ms;
+                        bestKind = k == 0 ? "warn" : "adzan";
+                        bestPrayer = p;
+                        bestMinute = t[p];
+                    }
+                }
+            }
+        }
+        if (bestKind == null) return;
+        Intent i = new Intent(context, AdzanReceiver.class).setAction(ACTION_FIRE)
+                .putExtra(EXTRA_KIND, bestKind)
+                .putExtra(EXTRA_PRAYER, bestPrayer)
+                .putExtra(EXTRA_MINUTE, bestMinute);
+        PendingIntent pi = PendingIntent.getBroadcast(context, 1, i,
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+        AlarmManager am = context.getSystemService(AlarmManager.class);
+        try {
+            am.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, bestAt, pi);
+        } catch (SecurityException e) {
+            // Android 12+ tanpa izin alarm tepat: tetap dijadwalkan, mungkin meleset beberapa menit.
+            am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, bestAt, pi);
+        }
+        Log.i(TAG, "next " + bestKind + " " + PrayerTimes.NAMES[bestPrayer] + " at "
+                + android.text.format.DateFormat.format("yyyy-MM-dd HH:mm:ss", bestAt));
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/AdzanService.java b/launcher/app/src/main/java/com/gathin/tvhome/AdzanService.java
new file mode 100644
index 0000000..7c6d54f
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/AdzanService.java
@@ -0,0 +1,272 @@
+package com.gathin.tvhome;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.PixelFormat;
+import android.media.AudioAttributes;
+import android.media.AudioFocusRequest;
+import android.media.AudioManager;
+import android.media.MediaPlayer;
+import android.os.IBinder;
+import android.provider.Settings;
+import android.util.DisplayMetrics;
+import android.util.Log;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+/**
+ * Peringatan 5 menit sebelum adzan (pil berkedip 30 detik di atas aplikasi apa pun) dan adzan
+ * (suara + panel "Waktu Dzuhur"; OK/Back menghentikan). Berjalan sebagai foreground service
+ * selama tampil, lalu berhenti sendiri. Screensaver diberi tahu lewat broadcast {@link #ACTION_SHOW}
+ * karena jendela screensaver berada di atas overlay.
+ */
+public class AdzanService extends Service {
+
+    static final String ACTION_SHOW = "com.gathin.tvhome.ADZAN_SHOW";
+    private static final String CHANNEL = "adzan";
+
+    private WindowManager wm;
+    private View warnView, adzanView;
+    private MediaPlayer player;
+    private AudioManager audio;
+    private AudioFocusRequest focus;
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        wm = getSystemService(WindowManager.class);
+        audio = getSystemService(AudioManager.class);
+        NotificationManager nm = getSystemService(NotificationManager.class);
+        nm.createNotificationChannel(new NotificationChannel(CHANNEL, "Adzan", NotificationManager.IMPORTANCE_LOW));
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        Notification n = new Notification.Builder(this, CHANNEL)
+                .setSmallIcon(android.R.drawable.ic_lock_idle_alarm)
+                .setContentTitle("Jadwal sholat")
+                .build();
+        startForeground(7, n);
+        if (intent == null) {
+            finish();
+            return START_NOT_STICKY;
+        }
+        String kind = intent.getStringExtra(AdzanScheduler.EXTRA_KIND);
+        int p = intent.getIntExtra(AdzanScheduler.EXTRA_PRAYER, 1);
+        String name = PrayerTimes.NAMES[p];
+        String time = PrayerTimes.hhmm(intent.getIntExtra(AdzanScheduler.EXTRA_MINUTE, 0));
+        Log.i(AdzanScheduler.TAG, "fire " + kind + " " + name + " " + time);
+        sendBroadcast(new Intent(ACTION_SHOW).setPackage(getPackageName())
+                .putExtra(AdzanScheduler.EXTRA_KIND, kind)
+                .putExtra("name", name).putExtra("time", time));
+        if ("adzan".equals(kind)) startAdzan(name, time);
+        else showWarning(name, time);
+        return START_NOT_STICKY;
+    }
+
+    private int screenH() {
+        DisplayMetrics dm = new DisplayMetrics();
+        wm.getDefaultDisplay().getRealMetrics(dm);
+        return Math.min(dm.widthPixels, dm.heightPixels);
+    }
+
+    private boolean canOverlay() {
+        return Settings.canDrawOverlays(this);
+    }
+
+    /** Nada pengumuman ala stasiun + "waktu sholat tiba"; video yang berjalan dikecilkan sebentar. */
+    private void playAnnouncement() {
+        AudioAttributes attrs = new AudioAttributes.Builder()
+                .setUsage(AudioAttributes.USAGE_NOTIFICATION_EVENT)
+                .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                .build();
+        AudioFocusRequest duck = new AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK)
+                .setAudioAttributes(attrs)
+                .setOnAudioFocusChangeListener(change -> { })
+                .build();
+        audio.requestAudioFocus(duck);
+        try {
+            MediaPlayer mp = MediaPlayer.create(this, R.raw.pengumuman,
+                    new AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_MEDIA)
+                            .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH).build(),
+                    audio.generateAudioSessionId());
+            mp.setOnCompletionListener(p -> {
+                p.release();
+                audio.abandonAudioFocusRequest(duck);
+            });
+            mp.start();
+        } catch (RuntimeException e) {
+            Log.e(AdzanScheduler.TAG, "gagal memutar pengumuman", e);
+            audio.abandonAudioFocusRequest(duck);
+        }
+    }
+
+    private void showWarning(String name, String time) {
+        removeWarning();
+        playAnnouncement();
+        if (!canOverlay()) {
+            Log.w(AdzanScheduler.TAG, "izin overlay belum ada");
+            finishIfIdle();
+            return;
+        }
+        int h = screenH();
+        TextView v = AdzanViews.warning(this, name, time, h);
+        WindowManager.LayoutParams lp = overlayParams(false);
+        lp.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL;
+        lp.y = Math.round(h * 0.06f);
+        wm.addView(v, lp);
+        warnView = v;
+        AdzanViews.blink(v, () -> {
+            removeWarning();
+            finishIfIdle();
+        });
+    }
+
+    private void startAdzan(String name, String time) {
+        removeWarning();
+        if (canOverlay()) {
+            int h = screenH();
+            FrameLayout root = new FrameLayout(this) {
+                @Override
+                public boolean dispatchKeyEvent(KeyEvent e) {
+                    int k = e.getKeyCode();
+                    if (e.getAction() == KeyEvent.ACTION_UP && (k == KeyEvent.KEYCODE_BACK
+                            || k == KeyEvent.KEYCODE_DPAD_CENTER || k == KeyEvent.KEYCODE_ENTER
+                            || k == KeyEvent.KEYCODE_HOME)) {
+                        stopAdzan();
+                    }
+                    // Tombol volume tetap ke sistem; tombol lain ditahan selama adzan.
+                    return !(k == KeyEvent.KEYCODE_VOLUME_UP || k == KeyEvent.KEYCODE_VOLUME_DOWN
+                            || k == KeyEvent.KEYCODE_VOLUME_MUTE);
+                }
+            };
+            TextView panel = AdzanViews.adzan(this, name, time, h);
+            root.addView(panel, new FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT,
+                    FrameLayout.LayoutParams.WRAP_CONTENT, Gravity.CENTER));
+            WindowManager.LayoutParams lp = overlayParams(true);
+            lp.width = WindowManager.LayoutParams.MATCH_PARENT;
+            lp.height = WindowManager.LayoutParams.MATCH_PARENT;
+            wm.addView(root, lp);
+            root.requestFocus();
+            adzanView = root;
+        }
+        AudioAttributes attrs = new AudioAttributes.Builder()
+                .setUsage(AudioAttributes.USAGE_MEDIA)
+                .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                .build();
+        focus = new AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT)
+                .setAudioAttributes(attrs)
+                .setOnAudioFocusChangeListener(change -> { })
+                .build();
+        audio.requestAudioFocus(focus);
+        try {
+            // res/raw/adzan.mp3 disediakan sendiri oleh pengguna (lihat README); tanpa file itu hanya panel yang tampil.
+            int res = getResources().getIdentifier("adzan", "raw", getPackageName());
+            if (res == 0) {
+                Log.w(AdzanScheduler.TAG, "res/raw/adzan.mp3 tidak ada, adzan tanpa suara");
+                return;
+            }
+            player = MediaPlayer.create(this, res, attrs, audio.generateAudioSessionId());
+            player.setOnCompletionListener(mp -> stopAdzan());
+            player.start();
+        } catch (RuntimeException e) {
+            Log.e(AdzanScheduler.TAG, "gagal memutar adzan", e);
+            stopAdzan();
+        }
+    }
+
+    private WindowManager.LayoutParams overlayParams(boolean focusable) {
+        int flags = WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                | WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON;
+        if (!focusable) {
+            flags |= WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                    | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE;
+        }
+        WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                WindowManager.LayoutParams.WRAP_CONTENT, WindowManager.LayoutParams.WRAP_CONTENT,
+                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY, flags, PixelFormat.TRANSLUCENT);
+        if (focusable) lp.dimAmount = 0.55f;
+        if (focusable) lp.flags |= WindowManager.LayoutParams.FLAG_DIM_BEHIND;
+        return lp;
+    }
+
+    private void stopAdzan() {
+        if (player != null) {
+            try {
+                player.stop();
+            } catch (RuntimeException ignored) {
+            }
+            player.release();
+            player = null;
+        }
+        if (focus != null) {
+            audio.abandonAudioFocusRequest(focus);
+            focus = null;
+        }
+        if (adzanView != null) {
+            wm.removeView(adzanView);
+            adzanView = null;
+        }
+        finishIfIdle();
+    }
+
+    private void removeWarning() {
+        if (warnView != null) {
+            warnView.animate().cancel();
+            try {
+                wm.removeView(warnView);
+            } catch (RuntimeException ignored) {
+            }
+            warnView = null;
+        }
+    }
+
+    private void finishIfIdle() {
+        if (warnView == null && adzanView == null && player == null) finish();
+    }
+
+    private void finish() {
+        stopForeground(true);
+        stopSelf();
+    }
+
+    @Override
+    public void onDestroy() {
+        removeWarning();
+        if (player != null || adzanView != null) stopAdzan();
+        super.onDestroy();
+    }
+
+    /** Untuk pratinjau tanpa tampil di TV: gambar peringatan ke PNG berukuran layar. */
+    static java.io.File renderWarningPng(Context c, String name, String time) throws java.io.IOException {
+        DisplayMetrics dm = new DisplayMetrics();
+        c.getSystemService(WindowManager.class).getDefaultDisplay().getRealMetrics(dm);
+        int w = dm.widthPixels, h = dm.heightPixels;
+        TextView v = AdzanViews.warning(c, name, time, Math.min(w, h));
+        v.measure(View.MeasureSpec.makeMeasureSpec(w, View.MeasureSpec.AT_MOST),
+                View.MeasureSpec.makeMeasureSpec(h, View.MeasureSpec.AT_MOST));
+        v.layout(0, 0, v.getMeasuredWidth(), v.getMeasuredHeight());
+        android.graphics.Bitmap bmp = android.graphics.Bitmap.createBitmap(w, h, android.graphics.Bitmap.Config.ARGB_8888);
+        android.graphics.Canvas canvas = new android.graphics.Canvas(bmp);
+        canvas.translate((w - v.getMeasuredWidth()) / 2f, Math.round(Math.min(w, h) * 0.06f));
+        v.draw(canvas);
+        java.io.File out = new java.io.File(c.getExternalFilesDir(null), "preview-warning.png");
+        try (java.io.FileOutputStream fos = new java.io.FileOutputStream(out)) {
+            bmp.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, fos);
+        }
+        return out;
+    }
+}
