--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/AdzanViews.java
@@ -0,0 +1,99 @@
+package com.gathin.tvhome;
+
+import android.animation.ObjectAnimator;
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.text.SpannableStringBuilder;
+import android.text.style.ForegroundColorSpan;
+import android.text.style.RelativeSizeSpan;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.TextView;
+
+/** Tampilan peringatan dan adzan, dipakai overlay {@link AdzanService} dan screensaver. */
+final class AdzanViews {
+
+    static final long BLINK_TOTAL_MS = 30_000L;
+    private static final int GOLD = 0xFFF2CD7A;
+
+    private AdzanViews() {}
+
+    private static Typeface font(Context c) {
+        try {
+            return c.getResources().getFont(R.font.outfit);
+        } catch (RuntimeException e) {
+            return Typeface.DEFAULT_BOLD;
+        }
+    }
+
+    /** Pil berkedip "⚠ 5 menit lagi Dzuhur · 11:16"; {@code screenH} = tinggi layar dalam px. */
+    static TextView warning(Context c, String prayer, String time, int screenH) {
+        TextView v = new TextView(c);
+        SpannableStringBuilder sb = new SpannableStringBuilder();
+        sb.append("5 menit lagi ");
+        int s = sb.length();
+        sb.append(prayer);
+        sb.setSpan(new ForegroundColorSpan(GOLD), s, sb.length(), 0);
+        s = sb.length();
+        sb.append("  ·  ").append(time);
+        sb.setSpan(new RelativeSizeSpan(0.85f), s, sb.length(), 0);
+        v.setText(sb);
+        style(c, v, screenH * 0.062f, screenH);
+        return v;
+    }
+
+    /** Panel besar saat adzan: "Waktu Dzuhur" dan petunjuk menghentikan. */
+    static TextView adzan(Context c, String prayer, String time, int screenH) {
+        TextView v = new TextView(c);
+        SpannableStringBuilder sb = new SpannableStringBuilder();
+        sb.append("Waktu ");
+        int s = sb.length();
+        sb.append(prayer);
+        sb.setSpan(new ForegroundColorSpan(GOLD), s, sb.length(), 0);
+        sb.append("  ").append(time).append("\n");
+        s = sb.length();
+        sb.append("Tekan OK atau Back untuk menghentikan adzan");
+        sb.setSpan(new RelativeSizeSpan(0.42f), s, sb.length(), 0);
+        sb.setSpan(new ForegroundColorSpan(0xFFC9CACD), s, sb.length(), 0);
+        v.setText(sb);
+        v.setLineSpacing(0f, 1.25f);
+        style(c, v, screenH * 0.09f, screenH);
+        return v;
+    }
+
+    private static void style(Context c, TextView v, float textPx, int screenH) {
+        v.setTypeface(font(c));
+        v.setFontVariationSettings("'wght' 600");
+        v.setTextColor(0xFFFFFFFF);
