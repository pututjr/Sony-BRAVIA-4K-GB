diff --git a/launcher/app/src/main/java/com/gathin/tvhome/DreamArt.java b/launcher/app/src/main/java/com/gathin/tvhome/DreamArt.java
new file mode 100644
index 0000000..d825996
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/DreamArt.java
@@ -0,0 +1,225 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RadialGradient;
+import android.graphics.Shader;
+import android.view.View;
+
+/** Gambar vektor untuk screensaver jadwal sholat: latar, garis emas, dan ikon. Tanpa file gambar. */
+final class DreamArt {
+
+    static final int GOLD = 0xFFE9B85C;
+    static final int GOLD_SOFT = 0xFFD9A955;
+
+    private DreamArt() {}
+
+    /** Latar biru malam dengan pola geometris samar di sisi, cahaya senja, dan siluet masjid. */
+    static final class Background extends View {
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path path = new Path();
+
+        Background(Context c) {
+            super(c);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            int w = getWidth(), h = getHeight();
+            paint.setStyle(Paint.Style.FILL);
+            paint.setShader(new LinearGradient(0, 0, 0, h,
+                    new int[]{0xFF0A0F1C, 0xFF0C1324, 0xFF0A0E18, 0xFF06080D},
+                    new float[]{0f, 0.45f, 0.7f, 1f}, Shader.TileMode.CLAMP));
+            canvas.drawRect(0, 0, w, h, paint);
+
+            // Cahaya senja di kaki langit, kiri dan kanan.
+            for (float cx : new float[]{0.12f * w, 0.88f * w}) {
+                paint.setShader(new RadialGradient(cx, 0.66f * h, 0.30f * w,
+                        new int[]{0x66C87A2C, 0x22A0581E, 0x00000000}, new float[]{0f, 0.45f, 1f},
+                        Shader.TileMode.CLAMP));
+                canvas.drawRect(0, 0, w, h, paint);
+            }
+            paint.setShader(null);
+
+            drawPattern(canvas, w, h);
+
+            // Siluet masjid dan pepohonan.
+            paint.setColor(0xFF05070C);
+            float base = 0.76f * h, u = h / 1080f;
+            path.reset();
+            // kiri
+            minaret(path, 0.04f * w, base, 150 * u, 8 * u);
+            mosque(path, 0.075f * w, base, 48 * u);
+            minaret(path, 0.11f * w, base, 120 * u, 7 * u);
+            minaret(path, 0.13f * w, base, 135 * u, 7 * u);
+            mosque(path, 0.165f * w, base, 36 * u);
+            mosque(path, 0.20f * w, base, 28 * u);
+            // kanan
+            mosque(path, 0.79f * w, base, 30 * u);
+            minaret(path, 0.82f * w, base, 125 * u, 7 * u);
+            minaret(path, 0.838f * w, base, 145 * u, 7 * u);
+            mosque(path, 0.90f * w, base, 78 * u);
+            minaret(path, 0.965f * w, base, 110 * u, 7 * u);
+            canvas.drawPath(path, paint);
+            canvas.drawRect(0, base, 0.25f * w, h, paint);
+            canvas.drawRect(0.75f * w, base, w, h, paint);
+            // pepohonan di pojok bawah
+            paint.setColor(0xFF04060A);
+            for (int i = 0; i < 7; i++) {
+                canvas.drawCircle(0.01f * w + i * 22 * u, base + (20 + (i % 3) * 14) * u, (38 - i * 3) * u, paint);
+                canvas.drawCircle(w - 0.01f * w - i * 22 * u, base + (24 + (i % 2) * 16) * u, (36 - i * 3) * u, paint);
+            }
+            // tanah menyatu dengan latar bawah
+            paint.setShader(new LinearGradient(0, base - 40 * u, 0, h,
+                    new int[]{0x0006080D, 0xFF06080D}, null, Shader.TileMode.CLAMP));
+            canvas.drawRect(0, base - 40 * u, w, h, paint);
+            paint.setShader(null);
+        }
+
+        private static void mosque(Path p, float cx, float base, float r) {
+            float bodyH = r * 0.9f;
+            p.addRect(cx - r * 1.25f, base - bodyH, cx + r * 1.25f, base, Path.Direction.CW);
+            // kubah bawang
+            float top = base - bodyH;
+            p.moveTo(cx - r, top);
+            p.cubicTo(cx - r * 1.15f, top - r * 0.9f, cx - r * 0.25f, top - r * 1.15f, cx, top - r * 1.55f);
+            p.cubicTo(cx + r * 0.25f, top - r * 1.15f, cx + r * 1.15f, top - r * 0.9f, cx + r, top);
+            p.close();
+            p.addRect(cx - r * 0.03f, top - r * 1.85f, cx + r * 0.03f, top - r * 1.5f, Path.Direction.CW);
+        }
+
+        private static void minaret(Path p, float cx, float base, float height, float half) {
+            p.addRect(cx - half, base - height, cx + half, base, Path.Direction.CW);
+            p.addRect(cx - half * 1.6f, base - height * 0.72f, cx + half * 1.6f, base - height * 0.70f, Path.Direction.CW);
+            p.moveTo(cx - half * 1.2f, base - height);
+            p.lineTo(cx, base - height - half * 3.2f);
+            p.lineTo(cx + half * 1.2f, base - height);
+            p.close();
+        }
+
+        /** Bintang delapan samar di 14 % kiri dan kanan layar. */
+        private void drawPattern(Canvas canvas, int w, int h) {
+            Paint line = new Paint(Paint.ANTI_ALIAS_FLAG);
+            line.setStyle(Paint.Style.STROKE);
+            line.setStrokeWidth(Math.max(1f, h / 900f));
+            float s = h / 9f;
+            for (int side = 0; side < 2; side++) {
+                float x0 = side == 0 ? 0 : w - 0.14f * w;
+                for (float y = s / 2; y < 0.7f * h; y += s) {
+                    for (float x = x0 + s / 2; x < x0 + 0.14f * w + s; x += s) {
+                        float edge = side == 0 ? 1f - x / (0.14f * w) : (x - x0) / (0.14f * w);
+                        int a = (int) (22 * Math.max(0f, Math.min(1f, edge)) * (1f - y / (0.75f * h)));
+                        if (a <= 0) continue;
+                        line.setColor(a << 24 | 0x8899BB);
+                        star(canvas, x, y, s * 0.42f, line);
+                    }
+                }
+            }
+        }
+
+        private static void star(Canvas c, float cx, float cy, float r, Paint p) {
+            c.save();
+            c.translate(cx, cy);
+            c.drawRect(-r * 0.7f, -r * 0.7f, r * 0.7f, r * 0.7f, p);
+            c.rotate(45);
+            c.drawRect(-r * 0.7f, -r * 0.7f, r * 0.7f, r * 0.7f, p);
+            c.restore();
+        }
+    }
+
+    /** Garis tipis memudar di kedua ujung. */
+    static final class FadeLine extends View {
+        private final Paint paint = new Paint();
+        private final int color;
+
+        FadeLine(Context c, int color) {
+            super(c);
+            this.color = color;
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            int w = getWidth(), h = getHeight();
+            int clear = color & 0x00FFFFFF;
+            paint.setShader(new LinearGradient(0, 0, w, 0, new int[]{clear, color, color, clear},
+                    new float[]{0f, 0.3f, 0.7f, 1f}, Shader.TileMode.CLAMP));
+            canvas.drawRect(0, 0, w, h, paint);
+        }
+    }
+
+    /** Ikon lokasi (pin) atau bulan sabit dengan bintang, emas. */
+    static final class Icon extends View {
+        static final int PIN = 0, MOON = 1;
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path path = new Path();
+        private final int kind;
+
+        Icon(Context c, int kind) {
+            super(c);
+            this.kind = kind;
+            paint.setColor(GOLD);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            float w = getWidth(), h = getHeight();
+            path.reset();
+            if (kind == PIN) {
+                float r = w * 0.36f, cx = w / 2f, cy = h * 0.38f;
+                path.addCircle(cx, cy, r, Path.Direction.CW);
+                path.moveTo(cx - r * 0.86f, cy + r * 0.5f);
+                path.lineTo(cx, h * 0.95f);
+                path.lineTo(cx + r * 0.86f, cy + r * 0.5f);
+                path.close();
+                canvas.drawPath(path, paint);
+                Paint hole = new Paint(Paint.ANTI_ALIAS_FLAG);
+                hole.setColor(0xFF0B1120);
+                canvas.drawCircle(cx, cy, r * 0.42f, hole);
+            } else {
+                float r = Math.min(w, h) * 0.46f, cx = w * 0.48f, cy = h / 2f;
+                path.addCircle(cx, cy, r, Path.Direction.CW);
+                Path cut = new Path();
+                cut.addCircle(cx + r * 0.42f, cy - r * 0.18f, r * 0.84f, Path.Direction.CW);
+                path.op(cut, Path.Op.DIFFERENCE);
+                canvas.drawPath(path, paint);
+                drawStar(canvas, cx + r * 0.38f, cy - r * 0.05f, r * 0.26f);
+            }
+        }
+
+        private void drawStar(Canvas c, float cx, float cy, float r) {
+            Path s = new Path();
+            for (int i = 0; i < 10; i++) {
+                double a = Math.PI / 2 + i * Math.PI / 5;
+                float rr = i % 2 == 0 ? r : r * 0.42f;
+                float x = cx + (float) (rr * Math.cos(a)), y = cy - (float) (rr * Math.sin(a));
+                if (i == 0) s.moveTo(x, y);
+                else s.lineTo(x, y);
+            }
+            s.close();
+            c.drawPath(s, paint);
+        }
+    }
+
+    /** Kartu sudut membulat; {@code active} memberi bingkai emas dengan cahaya lembut. */
+    static android.graphics.drawable.Drawable card(float radius, boolean active, float px) {
+        android.graphics.drawable.GradientDrawable inner = new android.graphics.drawable.GradientDrawable();
+        inner.setCornerRadius(radius);
+        inner.setColor(active ? 0xF0201B14 : 0xE014171F);
+        if (active) inner.setStroke(Math.max(2, Math.round(px * 2.5f)), GOLD);
+        else inner.setStroke(Math.max(1, Math.round(px)), 0x22FFFFFF);
+        if (!active) return inner;
+        android.graphics.drawable.GradientDrawable glow = new android.graphics.drawable.GradientDrawable();
+        glow.setCornerRadius(radius + px * 6);
+        glow.setColor(0x00000000);
+        glow.setStroke(Math.round(px * 6), 0x33E9B85C);
+        android.graphics.drawable.LayerDrawable ld = new android.graphics.drawable.LayerDrawable(
+                new android.graphics.drawable.Drawable[]{glow, inner});
+        int in = Math.round(px * 6);
+        ld.setLayerInset(1, in, in, in, in);
+        return ld;
+    }
+
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/FlipClockView.java b/launcher/app/src/main/java/com/gathin/tvhome/FlipClockView.java
new file mode 100644
index 0000000..7c1f1f0
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/FlipClockView.java
@@ -0,0 +1,219 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Camera;
+import android.graphics.Canvas;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+import android.os.SystemClock;
+import android.view.View;
+
+import java.util.Calendar;
+
+/**
+ * Jam flip besar HH:MM:SS (24 jam) untuk screensaver, dibuat agar terbaca dari jarak jauh.
+ * Enam kartu angka dengan dua titik dua; angka yang berganti dibalik seperti jam flip mekanik:
+ * separuh atas angka lama jatuh ke bawah, lalu separuh bawah angka baru menutup.
+ *
+ * <p>Ukuran mengikuti lebar yang diberikan (lihat {@link #setDigitWidth}); tinggi kartu 1,45 x lebarnya.
+ * View hanya menggambar ulang selama ada kartu yang sedang dibalik, jadi ringan untuk TV 2 GB.
+ */
+public class FlipClockView extends View {
+
+    private static final long FLIP_MS = 520L;
+    private static final int CARD = 0xFF2B2B30;
+    private static final int CARD_SHADE = 0xFF232327;
+    private static final int DIGIT = 0xFFF2F2F4;
+    private static final int HINGE = 0xFF141416;
+    private static final int COLON = 0xFFB5B6B8;
+
+    private final Paint cardPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint digitPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint hingePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint colonPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Camera camera = new Camera();
+    private final Matrix matrix = new Matrix();
+    private final RectF card = new RectF();
+    private final Rect bounds = new Rect();
+
+    private final char[] shown = new char[6];
+    private final char[] previous = new char[6];
+    private final long[] flipStart = new long[6];
+
+    private float digitW = 200f, digitH = 290f, gapIn, gapColon, colonW, radius;
+    private boolean running;
+
+    private final Runnable second = new Runnable() {
+        @Override
+        public void run() {
+            if (!running) return;
+            updateTime(true);
+            // Tepat di pergantian detik berikutnya.
+            postDelayed(this, 1000L - (System.currentTimeMillis() % 1000L));
+        }
+    };
+
+    public FlipClockView(Context context) {
+        super(context);
+        Typeface face;
+        try {
+            face = context.getResources().getFont(R.font.outfit);
+        } catch (RuntimeException e) {
+            face = Typeface.DEFAULT_BOLD;
+        }
+        digitPaint.setTypeface(face);
+        digitPaint.setFontVariationSettings("'wght' 600");
+        digitPaint.setColor(DIGIT);
+        digitPaint.setTextAlign(Paint.Align.CENTER);
+        hingePaint.setColor(HINGE);
+        colonPaint.setColor(COLON);
+        updateTime(false);
+    }
+
+    /** Lebar satu kartu angka dalam piksel; semua ukuran lain mengikuti. */
+    public void setDigitWidth(float w) {
+        digitW = w;
+        digitH = w * 1.45f;
+        gapIn = w * 0.07f;
+        gapColon = w * 0.10f;
+        colonW = w * 0.22f;
+        radius = w * 0.09f;
+        digitPaint.setTextSize(digitH * 0.80f);
+        hingePaint.setStrokeWidth(Math.max(2f, digitH * 0.012f));
+        requestLayout();
+        invalidate();
+    }
+
+    /** Lebar total untuk lebar kartu {@code w}: 6 kartu, 3 celah dalam grup, 2 titik dua. */
+    public static float widthFor(float w) {
+        return 6f * w + 3f * (w * 0.07f) + 2f * (w * 0.22f + 2f * w * 0.10f);
+    }
+
+    public void start() {
+        if (running) return;
+        running = true;
+        updateTime(false);
+        removeCallbacks(second);
+        postDelayed(second, 1000L - (System.currentTimeMillis() % 1000L));
+    }
+
+    public void stop() {
+        running = false;
+        removeCallbacks(second);
+    }
+
+    private void updateTime(boolean animate) {
+        Calendar c = Calendar.getInstance();
+        String s = String.format(java.util.Locale.ROOT, "%02d%02d%02d",
+                c.get(Calendar.HOUR_OF_DAY), c.get(Calendar.MINUTE), c.get(Calendar.SECOND));
+        long now = SystemClock.uptimeMillis();
+        for (int i = 0; i < 6; i++) {
+            char ch = s.charAt(i);
+            if (shown[i] == ch) continue;
+            previous[i] = shown[i] == 0 ? ch : shown[i];
+            shown[i] = ch;
+            flipStart[i] = animate ? now : 0L;
+        }
+        invalidate();
+    }
+
+    @Override
+    protected void onMeasure(int widthSpec, int heightSpec) {
+        setMeasuredDimension(Math.round(widthFor(digitW)), Math.round(digitH));
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        long now = SystemClock.uptimeMillis();
+        boolean animating = false;
+        float x = 0f;
+        for (int i = 0; i < 6; i++) {
+            float p = flipStart[i] == 0L ? 1f : Math.min(1f, (now - flipStart[i]) / (float) FLIP_MS);
+            if (p < 1f) animating = true;
+            drawDigit(canvas, x, i, ease(p));
+            x += digitW;
+            if (i == 1 || i == 3) {
+                drawColon(canvas, x + gapColon);
+                x += gapColon * 2f + colonW;
+            } else if (i % 2 == 0) {
+                x += gapIn;
+            }
+        }
+        if (animating) postInvalidateOnAnimation();
+    }
+
+    private static float ease(float p) {
+        return p < 0.5f ? 2f * p * p : 1f - (float) Math.pow(-2f * p + 2f, 2) / 2f;
+    }
+
+    private void drawColon(Canvas canvas, float x) {
+        float r = colonW * 0.36f;
+        float cx = x + colonW / 2f;
+        canvas.drawCircle(cx, digitH * 0.33f, r, colonPaint);
+        canvas.drawCircle(cx, digitH * 0.67f, r, colonPaint);
+    }
+
+    private void drawDigit(Canvas canvas, float x, int i, float p) {
+        float mid = digitH / 2f;
+        String now = String.valueOf(shown[i]);
+        String old = String.valueOf(previous[i] == 0 ? shown[i] : previous[i]);
+        if (p >= 1f) {
+            half(canvas, x, now, true, CARD);
+            half(canvas, x, now, false, CARD_SHADE);
+        } else {
+            // Di belakang: atas angka baru, bawah angka lama.
+            half(canvas, x, now, true, CARD);
+            half(canvas, x, old, false, CARD_SHADE);
+            // Kartu yang sedang dibalik, berputar pada engsel tengah.
+            canvas.save();
+            float angle;
+            boolean top;
+            String flap;
+            if (p < 0.5f) {
+                angle = -180f * p;          // atas angka lama jatuh ke depan
+                top = true;
+                flap = old;
+            } else {
+                angle = 180f * (1f - p);    // bawah angka baru turun menutup
+                top = false;
+                flap = now;
+            }
+            camera.save();
+            camera.setLocation(0f, 0f, -digitH * 0.06f);
+            camera.rotateX(angle);
+            camera.getMatrix(matrix);
+            camera.restore();
+            float cx = x + digitW / 2f;
+            matrix.preTranslate(-cx, -mid);
+            matrix.postTranslate(cx, mid);
+            canvas.concat(matrix);
+            half(canvas, x, flap, top, top ? CARD : CARD_SHADE);
+            canvas.restore();
+        }
+        canvas.drawLine(x, mid, x + digitW, mid, hingePaint);
+    }
+
+    /** Separuh atas atau bawah satu kartu dengan angkanya. */
+    private void half(Canvas canvas, float x, String digit, boolean top, int color) {
+        float mid = digitH / 2f;
+        canvas.save();
+        if (top) canvas.clipRect(x, 0f, x + digitW, mid);
+        else canvas.clipRect(x, mid, x + digitW, digitH);
+        cardPaint.setColor(color);
+        card.set(x, 0f, x + digitW, digitH);
+        canvas.drawRoundRect(card, radius, radius, cardPaint);
+        digitPaint.getTextBounds("0", 0, 1, bounds);
+        float baseline = mid - bounds.exactCenterY();
+        canvas.drawText(digit, x + digitW / 2f, baseline, digitPaint);
+        canvas.restore();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        stop();
+        super.onDetachedFromWindow();
+    }
+}
